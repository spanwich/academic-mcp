# Copy to `.env` next to compose.yml on the docker farm and fill in.
# Never commit real values.

# ── Secrets ─────────────────────────────────────────────────────────────

# Bearer token clients must present on every MCP request.
# Generate with: openssl rand -hex 32
ACADEMIC_MCP_TOKEN=

# Cloudflared named-tunnel token.
# Obtain by running (once, on any machine with a browser):
#   cloudflared tunnel create academic-mcp
#   cloudflared tunnel route dns academic-mcp mcp.example.com
# then in the Cloudflare Zero Trust dashboard, configure the tunnel to
# forward http://mcp:8000 and copy the connector install token here.
CF_TUNNEL_TOKEN=

# ── Model selection ─────────────────────────────────────────────────────
# Both must already be pulled on the GPU farm's Ollama
# (ssh iamfo470@deep.otago.ac.nz, then `ollama pull <model>` inside the
# tmux session that runs `ollama serve`).

ACADEMIC_LLM_MODEL=qwen3:8b
ACADEMIC_EMBEDDING_MODEL=nomic-embed-text
