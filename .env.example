# Academic Paper MCP Server Configuration
# Uncomment and modify as needed

# Database
ACADEMIC_DATABASE_URL=sqlite:///data/papers.db

# Vector store
ACADEMIC_CHROMA_PERSIST_DIR=./data/chroma
ACADEMIC_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# LLM Configuration
ACADEMIC_LLM_MODEL=qwen2.5:7b
ACADEMIC_OLLAMA_HOST=http://localhost:11434

# Processing
ACADEMIC_CHUNK_SIZE=800
ACADEMIC_MAX_EXTRACTION_TOKENS=12000

# Zotero (optional)
ACADEMIC_ZOTERO_ENABLED=false
# ACADEMIC_ZOTERO_PATH=/path/to/Zotero

# Logging
ACADEMIC_LOG_LEVEL=INFO

# --- Remote HTTP MCP deployment (src/server_http.py) ---
# Used when exposing the MCP to claude.ai from a VM. Leave unset on the laptop.
#
# ACADEMIC_MCP_TOKEN: bearer token clients must present (generate with: openssl rand -hex 32)
# ACADEMIC_MCP_HTTP_HOST: bind address, default 127.0.0.1 (put a reverse proxy / cloudflared in front for TLS)
# ACADEMIC_MCP_HTTP_PORT: default 8000
# ACADEMIC_MCP_REMOTE_MODE: set to 1 on the VM to hide Ollama/Zotero-dependent tools
#
# ACADEMIC_MCP_TOKEN=
# ACADEMIC_MCP_HTTP_HOST=127.0.0.1
# ACADEMIC_MCP_HTTP_PORT=8000
# ACADEMIC_MCP_REMOTE_MODE=1
